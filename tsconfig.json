{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // FASE 2: arrancamos en modo permisivo a propósito.
    // Cuando te sientas cómodo, pon "strict": true y ve arreglando lo que salga.
    // Ver README.md § "Endurecer TypeScript".
    "strict": false,

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
