{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // Arrancamos en modo permisivo a propósito, pero con una excepción:
    // strictNullChecks se activó en la Fase 3 porque sin él TypeScript no
    // estrecha uniones discriminadas por booleano, y todo el sistema las usa
    // ({ ok: true } | { ok: false, rejection }). Salió gratis: cero errores.
    // Siguiente paso cuando te sientas cómodo: "strict": true.
    // Ver README.md § "Endurecer TypeScript".
    "strict": false,
    "strictNullChecks": true,

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
