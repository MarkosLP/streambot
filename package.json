{
  "name": "crid4m-interaction-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Sistema de interacciones para el canal de Twitch Crid4m. Fase 2: esqueleto.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "simulate": "tsx --disable-warning=ExperimentalWarning src/cli/simulate.ts",
    "sonidos": "tsx src/cli/generar-sonidos.ts",
    "ai:test": "tsx --disable-warning=ExperimentalWarning src/cli/ai-test.ts",
    "test": "tsx --disable-warning=ExperimentalWarning --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "laboratorio": "tsx --disable-warning=ExperimentalWarning src/cli/laboratorio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@streamerbot/client": "^1.12.0",
    "dotenv": "^17.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
