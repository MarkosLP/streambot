# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube a git (está en .gitignore).

# --- Streamer.bot: servidor WebSocket ---
# En Streamer.bot: pestaña "Servers/Clients" -> "WebSocket Server"
# Por defecto escucha solo en localhost. No lo abras a internet.
STREAMERBOT_HOST=127.0.0.1
STREAMERBOT_PORT=8080
STREAMERBOT_ENDPOINT=/

# Contraseña del WebSocket Server.
# OBLIGATORIA a partir de la Fase 3: la petición SendMessage exige autenticación.
# Sin ella el sistema recibe eventos pero NO puede escribir en el chat.
STREAMERBOT_PASSWORD=

# false = el bot escribe desde la cuenta del canal.
# true  = escribe desde la cuenta de bot configurada en Streamer.bot.
STREAMERBOT_USE_BOT_ACCOUNT=false

# --- Panel de control ---
# Se abre en http://127.0.0.1:7070 mientras el bot está en marcha.
# Solo escucha en este PC: no es accesible desde la red ni desde internet.
PANEL_ENABLED=true
PANEL_PORT=7070

# --- OBS ---
# Solo para que el panel cree las fuentes y filtros de los efectos.
# Los datos están en OBS: Herramientas → Configuración del servidor WebSocket
# → Mostrar información de conexión.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
# La fuente del juego: la que tiembla con el Terremoto.
OBS_FUENTE_JUEGO=Captura de ventana

# --- Comportamiento ---
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Guardar en logs/raw-events.log los payloads de eventos que todavía no normalizamos.
# Sirve para construir los normalizadores de la Fase 3 con datos reales.
CAPTURE_RAW_EVENTS=true

# ¿Puede el bot hablar sin que nadie le invoque?
# true  = #1 Primer Mensaje saluda a quien escribe por primera vez (sin IA,
#         es una pregunta de una lista fija, no cuesta dinero).
# false = solo responde a !pregunta, !preguntar y al Channel Point.
# En los dos casos sigue registrando quién escribe y cuándo, nunca el texto.
INTERACCIONES_ESPONTANEAS=true

# Login de Twitch del dueño del canal, en minúsculas.
# Se usa para saber quién puede usar !apagar y !encender, y para que el
# sistema no se salude a sí mismo. COMPRUEBA QUE ES EL TUYO DE VERDAD.
BROADCASTER_LOGIN=crid4m

# --- Base de datos ---
# Archivo SQLite. El simulador usa otro distinto (data/crid4m.sim.sqlite).
DB_PATH=data/crid4m.sqlite

# --- Límites ---
# Cuentas que el sistema ignora por completo: otros bots del chat.
# Sin esto, lo primero que haría el bot es dar la bienvenida a StreamElements.
IGNORED_LOGINS=streamelements,streamlabs,nightbot,moobot,fossabot,sery_bot,wizebot

# Techo de mensajes del bot por hora (docs/04 § R4: que el bot se perciba
# como spam es el riesgo número uno del producto).
BOT_MESSAGES_PER_HOUR=12
# Aparte: respuestas a comandos, canjes y botones del panel. No gastan del de arriba.
BOT_RESPUESTAS_PER_HOUR=60

# true = no envía nada a Twitch, solo registra lo que enviaría.
# Útil para hacer un directo de prueba sin ningún riesgo.
DRY_RUN=false

# --- #1 Primer Mensaje (Fase 6) ---
# true  = se saluda solo si Streamer.bot marca el mensaje como el PRIMERO del
#         usuario en el canal. Es la fuente correcta y la del catálogo.
# false = criterio antiguo: saluda a quien sea nuevo en nuestra base de datos.
#         Ojo, eso saluda a todos tus habituales el dia que estrenas el bot.
PRIMER_MENSAJE_CONFIA_EN_FLAG=true

# --- #18 Bienvenida de Vuelta (Fase 6) ---
# Dias sin aparecer a partir de los cuales alguien "vuelve" (docs/02).
# Por debajo de dos semanas la vuelta no se percibe como tal.
BIENVENIDA_VUELTA_DIAS=14

# --- Modo revisión (Fase 5) ---
# true = lo que genere la IA espera tu aprobación por consola antes de
# publicarse. Escribes "s" para publicar o "n" para descartar.
# Solo afecta al texto generado por Claude: los saludos y los textos de
# reserva son deterministas y salen directos.
# Se desactiva tras los dos directos de validación.
REVIEW_MODE=true

# --- Pregunta a Crid4m AI (Fase 5) ---
# ID de la recompensa de Channel Points. Es lo más fiable, porque no cambia
# aunque la renombres. Lo verás en la consola al redimirla con LOG_LEVEL=debug.
PREGUNTA_IA_REWARD_ID=

# Si dejas el ID vacío, se busca por nombre exacto.
PREGUNTA_IA_REWARD_TITLE=Pregunta a Crid4m AI

# Cooldowns del comando gratuito !pregunta, en milisegundos (docs/02 § 3).
# Las redenciones de Channel Points NO usan estos cooldowns: su limitador es
# el coste en puntos, configurado en Twitch. Si no, alguien pagaría y no
# recibiría nada.
PREGUNTA_IA_COOLDOWN_GLOBAL_MS=300000
PREGUNTA_IA_COOLDOWN_USER_MS=900000

# Preguntas más largas se descartan antes de gastar dinero en la IA.
PREGUNTA_IA_MAX_INPUT=300

# --- #10 Pregunta Incomoda (Fase 7) ---
# La recompensa saca una pregunta personal del banco y la respondes en voz
# alta. El banco lo escribes TU, en src/interactions/pregunta-incomoda.ts:
# ahi esta todo el control del riesgo de esta interaccion.
PREGUNTA_INCOMODA_REWARD_ID=
PREGUNTA_INCOMODA_REWARD_TITLE=Pregunta Incómoda
# Solo afecta al comando !incomoda (que es para subs). El Channel Point no
# usa cooldown: ya se paga con puntos.
PREGUNTA_INCOMODA_COOLDOWN_MS=300000

# --- Memoria (Fase 8) ---
# Dias que vive un recuerdo antes de borrarse solo. 90 sale de docs/02: un
# dato de hace cuatro meses que la persona ya no recuerda haber dicho
# desconcierta en vez de agradar.
MEMORIA_DIAS_CADUCIDAD=90
# Tope del texto libre que escribio un desconocido (docs/02, #2).
MEMORIA_MAX_LONGITUD=60
# Tope de la fila entera, que ademas del fragmento ajeno lleva contexto
# nuestro (en #2, la pregunta Y la respuesta).
MEMORIA_MAX_CONTENIDO=200
# Minutos tras el saludo de #1 en los que la respuesta cuenta como ticket.
TICKET_VENTANA_MINUTOS=2

# --- #15 Dato Inutil (Fase 8) ---
# OJO: es la unica llamada a la IA que dispara el CHAT y no una persona.
# Estos dos valores son lo que impide que un chat animado se convierta en una
# factura. Subirlos cuesta dinero de verdad.
# Por debajo de estos caracteres no se mira el mensaje ("jajaja" no es un dato).
DATO_INUTIL_MIN_CARACTERES=40
# Tiempo entre extracciones, sea de quien sea. Ademas, solo se mira UN mensaje
# por persona y directo.
DATO_INUTIL_COOLDOWN_MS=600000

# --- IA (Fase 4) ---
# Clave de la API de Anthropic. Se consigue en console.anthropic.com.
# NUNCA se sube a git, nunca se escribe en el código, nunca se imprime en logs.
ANTHROPIC_API_KEY=

# Modelo. Decidido en docs/01 § 4.3. Alternativas más baratas si algún día
# hiciera falta: claude-sonnet-5 (2,5x más barato), claude-haiku-4-5 (5x).
AI_MODEL=claude-opus-5

# Tope de tokens de salida. Cubre razonamiento + respuesta.
AI_MAX_TOKENS=4000

# Timeout de la llamada en milisegundos (docs/01 § 3.3).
AI_TIMEOUT_MS=8000

# --- Topes de gasto ---
# Son CUATRO y se comprueban todos antes de cada llamada: basta con que uno
# salte para que no se llame a Anthropic. Al saltar, la capa de IA deja de
# llamar y el resto del sistema sigue funcionando con el texto de reserva.

# Por directo, en dólares (docs/04 § 1.5). Vive en memoria: empieza de cero
# cada vez que arrancas el proceso.
AI_BUDGET_PER_STREAM_USD=3

# Por día y por mes, en dólares. Estos salen de la tabla `ai_usage` en
# SQLite, así que NO se reinician al reiniciar el bot. El corte del día y el
# del mes caen a medianoche local, no UTC, para no partir un directo que
# cruza la medianoche.
AI_BUDGET_PER_DAY_USD=5
AI_BUDGET_PER_MONTH_USD=20

# Tope de llamadas al día, además del de dinero. No es redundante: el coste
# solo se conoce si el modelo está en nuestra tabla de precios, y contar
# llamadas funciona aunque el precio se desconozca.
AI_MAX_CALLS_PER_DAY=250

# Caché del prompt de sistema: 5m | 1h | off.
# La personalidad son ~960 tokens idénticos en cada pregunta. Cachearlos es
# el mayor ahorro disponible sin tocar la calidad de las respuestas.
# 1h porque las preguntas llegan separadas por minutos: con el TTL de 5
# minutos la entrada caduca entre preguntas y se paga la escritura sin
# llegar a leerla. Con 1h sale a cuenta desde la tercera pregunta de la hora.
AI_CACHE_TTL=1h

# --- Loot del chat ---
# Cada 20-30 min cae un cofre para quien haya escrito en el chat hace poco.
# Solo durante un directo. Se enciende y apaga también desde el panel.
LOOT_ACTIVO=true
LOOT_MINUTOS_MIN=20
LOOT_MINUTOS_MAX=30
LOOT_MINUTOS_ACTIVIDAD=15
# El Cofre del tesoro (1.500 Oros). Se reconoce por el título; el id es más fiable.
LOOT_COFRE_REWARD_TITLE=Cofre del tesoro
# El canal juega al Loot como uno más (cofres, jefe, regalos). Se cambia también desde el panel.
LOOT_CANAL_JUEGA=true
LOOT_COFRE_REWARD_ID=
