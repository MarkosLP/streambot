# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube a git (está en .gitignore).

# --- Streamer.bot: servidor WebSocket ---
# En Streamer.bot: pestaña "Servers/Clients" -> "WebSocket Server"
# Por defecto escucha solo en localhost. No lo abras a internet.
STREAMERBOT_HOST=127.0.0.1
STREAMERBOT_PORT=8080
STREAMERBOT_ENDPOINT=/

# Contraseña del WebSocket Server.
# OBLIGATORIA a partir de la Fase 3: la petición SendMessage exige autenticación.
# Sin ella el sistema recibe eventos pero NO puede escribir en el chat.
STREAMERBOT_PASSWORD=

# false = el bot escribe desde la cuenta del canal.
# true  = escribe desde la cuenta de bot configurada en Streamer.bot.
STREAMERBOT_USE_BOT_ACCOUNT=false

# --- Comportamiento ---
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Guardar en logs/raw-events.log los payloads de eventos que todavía no normalizamos.
# Sirve para construir los normalizadores de la Fase 3 con datos reales.
CAPTURE_RAW_EVENTS=true

# Login de Twitch del dueño del canal, en minúsculas.
# Se usa para saber quién puede usar !apagar y !encender, y para que el
# sistema no se salude a sí mismo. COMPRUEBA QUE ES EL TUYO DE VERDAD.
BROADCASTER_LOGIN=crid4m

# --- Base de datos ---
# Archivo SQLite. El simulador usa otro distinto (data/crid4m.sim.sqlite).
DB_PATH=data/crid4m.sqlite

# --- Límites ---
# Cuentas que el sistema ignora por completo: otros bots del chat.
# Sin esto, lo primero que haría el bot es dar la bienvenida a StreamElements.
IGNORED_LOGINS=streamelements,streamlabs,nightbot,moobot,fossabot,sery_bot,wizebot

# Techo de mensajes del bot por hora (docs/04 § R4: que el bot se perciba
# como spam es el riesgo número uno del producto).
BOT_MESSAGES_PER_HOUR=12

# true = no envía nada a Twitch, solo registra lo que enviaría.
# Útil para hacer un directo de prueba sin ningún riesgo.
DRY_RUN=false

# --- Modo revisión (Fase 5) ---
# true = lo que genere la IA espera tu aprobación por consola antes de
# publicarse. Escribes "s" para publicar o "n" para descartar.
# Solo afecta al texto generado por Claude: los saludos y los textos de
# reserva son deterministas y salen directos.
# Se desactiva tras los dos directos de validación.
REVIEW_MODE=true

# --- Pregunta a Crid4m AI (Fase 5) ---
# ID de la recompensa de Channel Points. Es lo más fiable, porque no cambia
# aunque la renombres. Lo verás en la consola al redimirla con LOG_LEVEL=debug.
PREGUNTA_IA_REWARD_ID=

# Si dejas el ID vacío, se busca por nombre exacto.
PREGUNTA_IA_REWARD_TITLE=Pregunta a Crid4m AI

# Cooldowns del comando gratuito !pregunta, en milisegundos (docs/02 § 3).
# Las redenciones de Channel Points NO usan estos cooldowns: su limitador es
# el coste en puntos, configurado en Twitch. Si no, alguien pagaría y no
# recibiría nada.
PREGUNTA_IA_COOLDOWN_GLOBAL_MS=300000
PREGUNTA_IA_COOLDOWN_USER_MS=900000

# Preguntas más largas se descartan antes de gastar dinero en la IA.
PREGUNTA_IA_MAX_INPUT=300

# --- IA (Fase 4) ---
# Clave de la API de Anthropic. Se consigue en console.anthropic.com.
# NUNCA se sube a git, nunca se escribe en el código, nunca se imprime en logs.
ANTHROPIC_API_KEY=

# Modelo. Decidido en docs/01 § 4.3. Alternativas más baratas si algún día
# hiciera falta: claude-sonnet-5 (2,5x más barato), claude-haiku-4-5 (5x).
AI_MODEL=claude-opus-5

# Tope de tokens de salida. Cubre razonamiento + respuesta.
AI_MAX_TOKENS=4000

# Timeout de la llamada en milisegundos (docs/01 § 3.3).
AI_TIMEOUT_MS=8000

# Presupuesto máximo por directo, en dólares (docs/04 § 1.5).
# Al alcanzarlo, la capa de IA deja de llamar y el resto del sistema sigue.
AI_BUDGET_PER_STREAM_USD=3
