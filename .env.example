# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube a git (está en .gitignore).

# --- Streamer.bot: servidor WebSocket ---
# En Streamer.bot: pestaña "Servers/Clients" -> "WebSocket Server"
# Por defecto escucha solo en localhost. No lo abras a internet.
STREAMERBOT_HOST=127.0.0.1
STREAMERBOT_PORT=8080
STREAMERBOT_ENDPOINT=/

# Contraseña del WebSocket Server. Déjala vacía si no has activado autenticación.
# Recomendado: actívala en Streamer.bot y ponla aquí.
STREAMERBOT_PASSWORD=

# --- Comportamiento ---
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Guardar en logs/raw-events.log los payloads de eventos que todavía no normalizamos.
# Sirve para construir los normalizadores de la Fase 3 con datos reales.
CAPTURE_RAW_EVENTS=true

# Login de Twitch del dueño del canal, en minúsculas.
# Se usa para saber quién puede usar !apagar y !encender.
BROADCASTER_LOGIN=crid4m

# --- Fase 4 (todavía no se usa) ---
# ANTHROPIC_API_KEY=
